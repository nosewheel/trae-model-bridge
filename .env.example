# trae-model-bridge 配置示例。
#
# 复制为 .env 后按需修改：`cp .env.example .env`
# server 启动时会自动加载同目录下的 .env（Node ≥22.6 内置 process.loadEnvFile）。
# 所有变量都是可选的——不设置则使用下面注释里标注的默认值。
# .env 已被 .gitignore 忽略，不要提交真实凭证。

# ── 网络 ─────────────────────────────────────────────
# 监听地址与端口。（也可用 --host / --port 命令行参数覆盖）
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787

# ── 认证 ─────────────────────────────────────────────
# 客户端必须携带的 bearer token（Authorization: Bearer <token>）。
# 留空则不校验。
# BRIDGE_API_KEY=

# ── 模型 ─────────────────────────────────────────────
# 请求未指定模型时使用的默认模型。
# BRIDGE_DEFAULT_MODEL=doubao-seed-2.1-pro

# ── 日志 ─────────────────────────────────────────────
# 日志级别：off | info | debug。（也可用 --log-mode 覆盖）
# 日志输出到 stderr，可用 `2>> bridge.log` 追加到文件。
# BRIDGE_LOG_MODE=info
# debug 模式下单条 body/SSE 打印的最大字符数；<=0 表示不截断、打印完整。
# BRIDGE_LOG_MAX_CHARS=100000

# ── 思考内容 ─────────────────────────────────────────
# 是否把模型思考过程透出给客户端（Anthropic thinking 块等）。
# BRIDGE_REASONING=true

# ── traecli 凭证与缓存路径 ───────────────────────────
# 直接调用 llm_raw_chat 所需的 JWT + endpoints。默认取 ~/.trae 下。
# BRIDGE_AUTH_PATH=/Users/you/.trae/cli/auth.json
# BRIDGE_MODELS_CACHE_PATH=/Users/you/.trae/model-provider/trae/models_cache.json

# ── 并发与超时 ───────────────────────────────────────
# 最大并发上游请求数。
# BRIDGE_MAX_CONCURRENCY=2
# 单次上游调用的硬超时（毫秒）。
# BRIDGE_TIMEOUT_MS=600000

# ── 遗留 exec agent 模式（默认不使用；仅 traecli.ts 相关）────
# traecli/trae-cli 二进制路径。
# BRIDGE_TRAECLI_BIN=traecli
# 沙箱模式：read-only | workspace-write | danger-full-access。
# BRIDGE_SANDBOX=read-only
# agent 运行的工作目录（默认当前目录）。
# BRIDGE_CWD=
# 不将会话持久化到磁盘。
# BRIDGE_EPHEMERAL=true
# 允许在非 git 仓库目录运行。
# BRIDGE_SKIP_GIT_CHECK=true
